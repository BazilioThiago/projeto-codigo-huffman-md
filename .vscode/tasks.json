{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ESP-IDF Monitor (salvar continuamente em etapa2.log)",
      "type": "shell",
      "command": "& '${workspaceFolder}\\tools\\capture_monitor.ps1'",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "powershell.exe",
          "args": [
            "-NoLogo",
            "-NoProfile",
            "-ExecutionPolicy",
            "Bypass",
            "-Command"
          ]
        }
      },
      "problemMatcher": []
    }
  ]
}
